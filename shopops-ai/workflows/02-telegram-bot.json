    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'openrouter/free',\n  messages: [\n    { role: 'system', content: 'You are the customer support assistant of an Indian online store, chatting on Telegram. Use ONLY the order data you are given and never invent orders, statuses, dates or policies. You do NOT know delivery times or tracking details: if asked, say the team will share delivery and tracking details once the order ships. Status meanings: confirmed = being packed for shipping; new = just received; pending_confirmation = waiting for the customer to confirm their cash-on-delivery order using the buttons; on_hold = paused because it was not confirmed in time; cancelled = cancelled. If no orders are listed, ask them to open the order link they received. Classify the latest message as one of: order_status, return_request, complaint, general. For return_request or complaint, say a support ticket has been created and a person will contact them within 24 hours. Reply in under 60 words, friendly, plain text, no markdown. Respond with ONLY this JSON and nothing else: {\"intent\": \"...\", \"order_number\": \"the order it is about or null\", \"reply\": \"...\"}' },\n    { role: 'user', content: 'Customer: ' + JSON.stringify($json.customer) + '\\nTheir orders: ' + JSON.stringify($json.orders) + '\\nRecent chat: ' + JSON.stringify($json.history) + '\\nLatest message: ' + $('Route update').item.json.text }\n  ]\n}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "22a162af-bd50-4da3-b5ff-01fc870619d4",
      "name": "AI support",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        640
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3",
          "name": "OpenRouter"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Read the AI's JSON safely. If the AI failed, answer from the database instead.\nconst ctx = $('Get context').item.json;\nconst route = $('Route update').item.json;\n\nlet out = { intent: 'general', order_number: null, reply: '' };\ntry {\n  const text = $json.choices?.[0]?.message?.content ?? '';\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  if (match) out = { ...out, ...JSON.parse(match[0]) };\n} catch (e) {}\n\nconst allowed = ['order_status', 'return_request', 'complaint', 'general'];\nif (!allowed.includes(out.intent)) out.intent = 'general';\n\nif (!out.reply) {\n  const orders = ctx.orders || [];\n  out.reply = orders.length\n    ? 'Your latest order ' + orders[0].order_number + ' is currently: ' + String(orders[0].status).replace(/_/g, ' ') + '. A team member will help with anything else soon.'\n    : 'Hi! Please open the order link you received so I can find your order.';\n}\n\nreturn { json: {\n  chat_id: route.chat_id,\n  user_text: route.text,\n  intent: out.intent,\n  order_number: out.order_number || null,\n  reply: out.reply\n}};"
      },
