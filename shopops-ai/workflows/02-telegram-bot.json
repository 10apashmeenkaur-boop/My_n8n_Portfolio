    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Work out what kind of Telegram update this is.\nconst u = $json;\n\nif (u.callback_query) {\n  const cq = u.callback_query;\n  const [action, order_number] = String(cq.data || '').split(':');\n  return { json: { type: 'button', chat_id: cq.message.chat.id, action, order_number, callback_id: cq.id } };\n}\n\nconst m = u.message || {};\nconst chat_id = m.chat?.id;\nconst text = (m.text || '').trim();\nif (!chat_id || !text) return { json: { type: 'ignore' } };\n\nif (text === '/admin') return { json: { type: 'admin', chat_id } };\n\nconst start = text.match(/^\\/start\\s+(\\S+)/);\nif (start) return { json: { type: 'start', chat_id, order_number: start[1] } };\n\nreturn { json: { type: 'chat', chat_id, text: text === '/start' ? 'Hi' : text } };"
      },
