      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Read the AI's JSON safely. If the AI failed, answer from the database instead.\nconst ctx = $('Get context').item.json;\nconst route = $('Route update').item.json;\nconst pending = ctx.pending || [];\nconst orders = ctx.orders || [];\n\nlet out = { intent: 'general', order_number: null, reply: '' };\nlet aiOk = false;\ntry {\n  const text = $json.choices?.[0]?.message?.content ?? '';\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  if (match) { out = { ...out, ...JSON.parse(match[0]) }; aiOk = !!out.reply; }\n} catch (e) {}\n\nconst allowed = ['confirm_order', 'cancel_order', 'order_status', 'return_request', 'complaint', 'general'];\nif (!allowed.includes(out.intent)) out.intent = 'general';\n\n// Confirm / cancel by text: only for an order that is really waiting\nlet action = null;\nif (out.intent === 'confirm_order' || out.intent === 'cancel_order') {\n  const wanted = String(out.order_number || '').toUpperCase();\n  const match = pending.find(p => String(p.order_number).toUpperCase() === wanted) || (pending.length === 1 ? pending[0] : null);\n  if (match) {\n    out.order_number = match.order_number;\n    action = out.intent === 'confirm_order' ? 'confirm' : 'cancel';\n  } else {\n    out.intent = 'general';\n    out.reply = pending.length\n      ? 'Which order do you mean? You have these waiting: ' + pending.map(p => p.order_number).join(', ') + '.'\n      : \"You don't have any orders waiting for confirmation right now. 😊\";\n  }\n}\n\n// Fallback reply straight from the database if the AI failed\nif (!out.reply) {\n  const name = ctx.customer?.name ? ctx.customer.name + ', ' : '';\n  out.reply = orders.length\n    ? 'Hi ' + name + 'your latest order ' + orders[0].order_number + ' is ' + String(orders[0].status).replace(/_/g, ' ') + '. A team member will help with anything else soon.'\n    : 'Hi! A team member will get back to you shortly.';\n}\n\n// Telegram Markdown: escape characters the AI might use\nconst safe = String(out.reply).replace(/([\\\\_*`\\[])/g, '\\\\$1');\n\nreturn { json: {\n  chat_id: route.chat_id,\n  user_text: route.text,\n  intent: out.intent,\n  order_number: out.order_number || null,\n  action,\n  ai_ok: aiOk,\n  user_text_safe: String(route.text || '').replace(/([\\\\_*`\\[])/g, '\\\\$1'),\n  reply: safe\n}};"
      },
