      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Build the report. If the AI summary failed, send the numbers alone.\nconst s = $('Get daily numbers').item.json;\nconst ai = ($json.choices?.[0]?.message?.content || '').trim();\n\nconst lines = [\n  'ShopOps daily report - ' + s.date,\n  '',\n  'Orders today: ' + s.orders,\n  'Confirmed: ' + s.confirmed + ' (Rs ' + s.revenue_confirmed + ')',\n  'Waiting for confirmation: ' + s.pending_confirmation,\n  'Cancelled: ' + s.cancelled + ' | On hold: ' + s.on_hold,\n  'Risky COD value stopped: Rs ' + s.cod_value_stopped,\n  'Open support tickets: ' + s.open_tickets,\n  'Failed workflow runs: ' + s.failed_runs_today\n];\nif (ai) lines.push('', 'Insight: ' + ai);\n\nreturn { json: { chat_id: s.admin_chat_id, text: lines.join('\\n') } };"
      },
      "id": "6cdfbb5b-ed55-4c01-9fcd-2b62f6d83ec3",
      "name": "Build report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        180
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
